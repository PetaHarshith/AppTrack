{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": false,
        "types": ["node"]
    },
    "include": ["api/**/*", "Apptrack-backend/src/**/*"],
    "exclude": ["node_modules", "Apptrack-frontend", "apptrack-extension"]
}
