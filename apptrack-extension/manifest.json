{
  "manifest_version": 3,
  "name": "AppTrack",
  "version": "1.1.0",
  "description": "Save any job posting to AppTrack with one click. Get auto-prompted after you submit an application.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://apptrack.harshithpeta.com/*",
    "http://localhost:8000/*",
    "http://localhost:5173/*",
    "*://*.linkedin.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.workday.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.workable.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.workday.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.workable.com/*"
      ],
      "js": ["auto-detect.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to AppTrack",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
