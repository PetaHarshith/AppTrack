# ===== Database =====
# Local dev (Docker compose): postgresql://apptrack:apptrack_pw@localhost:5433/apptrack
# Production (Neon): paste the connection string from your Neon dashboard.
DATABASE_URL=postgresql://apptrack:apptrack_pw@localhost:5433/apptrack

# ===== Auth =====
# Generate a strong random value for production: `openssl rand -hex 32`
BETTER_AUTH_SECRET=replace-me-with-a-real-random-secret
# The URL the backend lives at. In Vercel: https://apptrack.harshithpeta.com
BETTER_AUTH_URL=http://localhost:8000

# ===== CORS / origins =====
# The URL the frontend is served from. Used to allowlist CORS + sign cookies.
# In Vercel: https://apptrack.harshithpeta.com
FRONTEND_URL=http://localhost:5173

# ===== Local-only =====
# These are read by docker-compose.yml and not by the app itself.
POSTGRES_USER=apptrack
POSTGRES_PASSWORD=apptrack_pw
POSTGRES_DB=apptrack
PGADMIN_DEFAULT_EMAIL=admin@apptrack.com
PGADMIN_DEFAULT_PASSWORD=admin_pw
